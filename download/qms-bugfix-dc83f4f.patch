+    return this.logAudit(action, tableName, recordId, oldValues, newValues, userId);
+  }
+
+  // Allow tests to inject a mock supabase client
+  public setSupabase(client: unknown) {
+    this.supabase = client as BaseService['supabase'];
+  }

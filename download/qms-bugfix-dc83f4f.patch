+                    </TableCell>
+                    <TableCell>
+                      {supplier.nextReviewDate ? (
+                        <div className="flex items-center gap-1">
+                          <span className={cn(
+                            'text-sm',
+                            isReviewOverdue(supplier.nextReviewDate) ? 'text-red-600 font-medium' :

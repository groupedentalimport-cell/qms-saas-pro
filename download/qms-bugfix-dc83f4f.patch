+// Organization hooks
+// ---------------------------------------------------------------------------
+
+export const useOrganizations = () =>
+  useQuery({
+    queryKey: ['organizations'],
+    queryFn: async () => {
+      const result = await organizationsApi.list();
+      if (result.success) return result.data;
+      throw new Error(result.error);
+    },

+  Training: 'Formation',
+  Risk: 'Risques',
+  ChangeControl: 'Change Control',
+  Deviation: 'Déviations',
+  Profile: 'Profils',
+  Organization: 'Organisation',
+};
+
+export const ACTION_LABELS: Record<string, string> = {
+  CREATE: 'Création',
+  UPDATE: 'Modification',
+  DELETE: 'Suppression',
+  APPROVE: 'Approbation',
+  REJECT: 'Rejet',
+  SIGN: 'Signature',
+  LOGIN: 'Connexion',

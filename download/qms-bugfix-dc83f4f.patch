+                {/* Linked CAPA */}
+                {(() => {
+                  const linkedCapa = getLinkedCapa(selectedDev.linkedCapaId);
+                  return linkedCapa ? (
+                    <div>
+                      <h4 className="font-medium text-sm mb-2 flex items-center gap-1">
+                        <Link2 className="h-4 w-4 text-muted-foreground" />

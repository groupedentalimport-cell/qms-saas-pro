+// Table name mappings (for display)
+// ============================================================================
+
+export const TABLE_LABELS: Record<string, string> = {
+  Document: 'Documents',
+  Capa: 'CAPA',
+  NonConformance: 'Non-conformités',
+  BatchRecord: 'Dossiers de Lot',

+  teal: 'hsl(173, 58%, 39%)',
+};
+
+// ---------------------------------------------------------------------------
+// Report Template type
+// ---------------------------------------------------------------------------
+
+interface ReportTemplate {
+  id: string;
+  title: string;
+  description: string;
+  icon: React.ReactNode;
+  color: string;

+        id: 'doc-wrong-ref',
+        documentNumber: 'SOP-OTHER-001',
+        type: 'SOP',
+        status: 'Approved',
+      });
+
+      useQMSStore.setState({
+        prerequisites: [prereq],
+        documents: [doc],
+      });
+
+      const result = checkPrerequisites('CAPA', 'org-001');

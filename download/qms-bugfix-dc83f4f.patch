+    id: 'document-status',
+    title: 'Document Status Report',
+    description: 'Document lifecycle status and approval metrics',
+    icon: <FileText className="h-6 w-6" />,
+    color: 'bg-teal-100 text-teal-700 dark:bg-teal-900/30 dark:text-teal-400',

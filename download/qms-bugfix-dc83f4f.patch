+                        {/* Confirmed OOS → rejection decision */}
+                        {selectedNcr.phase2Conclusion === 'Confirmed OOS' && (
+                          <div className="bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800 rounded-md p-3 space-y-2">

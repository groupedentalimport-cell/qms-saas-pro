+const documentLevels: DocumentLevel[] = [1, 2, 3, 4];
+
+// ═══════════════════════════════════════════════════════════════
+// Document Form Component (shared between Create & Edit)
+// ═══════════════════════════════════════════════════════════════
+
+interface DocumentFormProps {
+  editDocument?: Document | null;

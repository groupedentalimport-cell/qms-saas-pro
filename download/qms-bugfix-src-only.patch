+  async listInstances(page = 1, pageSize = 20, filters?: { status?: string; templateId?: string }) {
+    const from = (page - 1) * pageSize;
+    const to = from + pageSize - 1;
+    let query = this.supabase.from('form_instances').select('*', { count: 'exact' });

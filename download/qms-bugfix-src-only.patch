+                    ))}
+                  </SelectContent>
+                </Select>
+              </div>
+              <div className="grid gap-2">
+                <Label>Department / Departement</Label>
+                <Input value={formDepartment} onChange={(e) => setFormDepartment(e.target.value)} placeholder="Quality, Production..." />
+              </div>
+            </div>
+            {isEdit && editDocument && (
+              <div className="grid grid-cols-2 gap-4">
+                <div className="grid gap-2">

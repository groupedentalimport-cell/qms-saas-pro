+// ---------------------------------------------------------------------------
+// Sidebar Component
+// ---------------------------------------------------------------------------
+
+export function Sidebar({ activeSection, onSectionChange, collapsed, onToggle }: SidebarProps) {
+  const { orgSettings } = useOrganization();

+
+  const toggleSection = (id: string) => {
+    setSectionOpen(prev => ({ ...prev, [id]: !prev[id] }));
+  };
+
+  const isFormValid = formDocNumber.trim() !== '' && formTitle.trim() !== '';
+
+  const handleSave = (status: 'Draft' | 'In Review') => {

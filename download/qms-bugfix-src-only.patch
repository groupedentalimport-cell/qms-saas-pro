+                    ) : (
+                      <>
+                        <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
+                          {(['Use As Is', 'Rework', 'Scrap', 'Return to Supplier'] as NcrDisposition[]).map(d => (

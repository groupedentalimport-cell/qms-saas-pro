+      source: formSource || undefined,
+      description: formDescription,
+      lotNumber: formLotNumber || undefined,
+      quantityAffected: formQtyAffected ? parseInt(formQtyAffected) : undefined,
+      assignedTo: formAssignedTo || undefined,
+      disposition: 'Pending',
